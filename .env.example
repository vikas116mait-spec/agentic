DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentic"
DATABASE_SCHEMA="agentic_app"
# Connection pool bounds for the shared Postgres connection. Lower these if
# the database is also shared with other tenants and `FATAL: too many clients`
# starts appearing, raise them if you see `pool exhausted` under load.
DATABASE_MIN_POOL_SIZE="1"
DATABASE_MAX_POOL_SIZE="5"
# In-process TTL cache for the full state snapshot (milliseconds). Cuts
# Postgres round-trips for idle/polling GETs. Set to 0 to disable, or to a
# small value (e.g. 250) for a stricter read-after-write feel. Writers
# always invalidate the cache immediately. MUST be 0 if you run uvicorn
# with multiple workers.
DATABASE_STATE_CACHE_TTL_MS="1000"
# Deployment paths. Override these to point uploads and state at a mounted
# volume when running in Docker / Fly / k8s. Relative paths resolve against
# the repo root; absolute paths are used as-is.
AGENTIC_DATA_DIR=""
AGENTIC_UPLOADS_DIR=""
# Comma-separated list of origins allowed by the FastAPI CORS middleware.
# Use "*" for open access in development. In production set this to your
# Vercel domain, e.g. "https://agentic.vercel.app,https://preview-xyz.vercel.app".
ALLOWED_ORIGINS="*"
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_BASE_MODEL="qwen3:8b"
OLLAMA_AGENT_MODEL="qwen3:8b"

# Adaptive Ollama GPU selection (optional, opt-in).
# When enabled, the backend checks per-GPU free VRAM before every Ollama call
# and will atomically rewrite a systemd drop-in + passwordless-sudo-restart
# `ollama.service` onto the freest GPU when the pinned one is saturated.
# Requires a one-time admin setup - see README "Adaptive Ollama GPU" section.
OLLAMA_AUTO_MANAGE="0"
OLLAMA_DROPIN_PATH="/etc/systemd/system/ollama.service.d/cuda.conf"
OLLAMA_SERVICE_NAME="ollama.service"
OLLAMA_MIN_FREE_GPU_MB="8192"
OLLAMA_HEALTH_URL="http://127.0.0.1:11434/api/tags"
OLLAMA_RESTART_TIMEOUT_S="30"
OPENAI_API_KEY=""
OPENAI_AGENT_MODEL="gpt-5.4-mini"
AUTH_TRUST_HOST="true"

# Free inference providers (OpenAI-compatible API, inference-only)
GROQ_API_KEY=""
GOOGLE_API_KEY=""
CEREBRAS_API_KEY=""
TOGETHER_API_KEY=""
HF_TOKEN=""
HF_NAMESPACE=""
HF_BASE_MODEL="Qwen/Qwen2.5-3B-Instruct"
HF_DATASET_REPO=""
HF_MODEL_REPO_ID=""
HF_JOBS_FLAVOR="a10g-large"
HF_JOBS_TIMEOUT="3h"
HF_JOBS_IMAGE="huggingface/trl"
HF_TRACKIO_PROJECT="agentic-training"
HF_TRACKIO_SPACE_ID=""
LOCAL_TRAINING_ENABLED="1"
LOCAL_TRAINING_BASE_MODEL="Qwen/Qwen2.5-3B-Instruct"
LOCAL_TRAINING_PYTHON="/path/to/agentic/.venv-train/bin/python"
LOCAL_TRAINING_ALLOW_CPU_FALLBACK="0"
LOCAL_TRAINING_MULTI_GPU="0"
LOCAL_TRAINING_GPU_INDEX=""
LOCAL_TRAINING_EVAL_RATIO="0.1"
LOCAL_TRAINING_SEED="42"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:10087"
# URL of the Python FastAPI service. Read by the Next.js server (SSR + the
# /api/py proxy route) to forward requests to the backend. The browser never
# reads this -- it always talks to `/api/py/*` on the Next.js origin.
PYTHON_API_URL="http://127.0.0.1:10089"
# NEXT_PUBLIC_PYTHON_API_URL is deprecated. The client no longer calls the
# Python API directly; all browser requests go through the same-origin
# proxy at /api/py/[...path]. Setting this has no effect on the browser,
# and it is only still accepted on the server side as a fallback for
# PYTHON_API_URL to ease upgrades. Prefer PYTHON_API_URL alone.
# NEXT_PUBLIC_PYTHON_API_URL="http://127.0.0.1:10089"
TEMPORAL_ADDRESS="127.0.0.1:12404"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="agentic-agent-queue"
TEMPORAL_AUTO_START_DEV_SERVER="1"
TEMPORAL_DEV_SERVER_UI="0"
